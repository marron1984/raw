# データベース（SQLite）
DATABASE_URL="file:./dev.db"

# セッション署名用の秘密鍵（本番では必ず十分に長いランダム値に変更してください）
SESSION_SECRET="change-me-to-a-long-random-secret-string-please"

# アプリの公開URL（署名リンクの生成に使用）
APP_URL="http://localhost:3000"

# 初期管理者アカウント（seed 実行時に作成）
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="admin1234"
SEED_ADMIN_NAME="システム管理者"
