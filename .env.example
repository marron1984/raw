# ───────────────────────────────────────────────
# データベース（PostgreSQL）
# Neon / Vercel Postgres などのクラウドDBを使用します。
# Neon の場合は「Connection pooling」を【オフ】にした直結の接続文字列を設定してください。
# 例: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# セッション署名用の秘密鍵（本番では必ず十分に長いランダム値に変更してください）
# 生成例: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-secret-string-please"

# アプリの公開URL（署名リンクの生成に使用。Vercelの本番URLを設定）
# 例: https://raw-bay.vercel.app
APP_URL="http://localhost:3000"

# 共通パスワード（社員全員が使う合言葉。個別アカウントは不要）
# 未設定時は SEED_ADMIN_PASSWORD をフォールバックとして使用
APP_PASSCODE="set-your-own-passcode"

# メンテナンス用キー（契約データの一括リセットAPIを有効化。通常は未設定のまま）
# 設定時のみ /api/maintenance/reset-contracts?key=<この値> が有効
MAINTENANCE_KEY=""

# ───────────────────────────────────────────────
# 署名依頼メール（Resend）※任意。未設定時はメール送信せずURL案内のみ
# Resend (https://resend.com) で取得したAPIキー
RESEND_API_KEY=""
# 送信元アドレス。独自ドメインをResendで認証後に設定する。
# 例: "Dケア電子契約システム <keiyaku@aska-g.com>"
# 未設定時はテスト用 onboarding@resend.dev（自分のアカウント宛のみ届く）
MAIL_FROM=""

# ───────────────────────────────────────────────
# 締結済み契約PDFのGoogleドライブ自動保存（共有ドライブ）※任意・未設定時は保存しない
# サービスアカウントの鍵JSON（全文を1行で貼り付け。改行はそのままでよい）
GOOGLE_SERVICE_ACCOUNT_JSON=""
# 保存先フォルダID（共有ドライブ内のフォルダ。サービスアカウントを共有ドライブのメンバーに追加）
GDRIVE_FOLDER_ID=""
