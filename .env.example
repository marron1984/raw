# データベース（SQLite）
DATABASE_URL="file:./dev.db"

# セッション署名用の秘密鍵（本番では必ず十分に長いランダム値に変更してください）
SESSION_SECRET="change-me-to-a-long-random-secret-string-please"

# アプリの公開URL（署名リンクの生成に使用）
APP_URL="http://localhost:3000"

# 初期管理者アカウント（seed 実行時に作成）
# パスワードは各自の .env に設定してください（このサンプルには実値を書かないこと）
SEED_ADMIN_EMAIL="yoshida@aska-g.com"
SEED_ADMIN_PASSWORD="set-your-own-password"
SEED_ADMIN_NAME="吉田"
